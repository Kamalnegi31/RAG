# =============================================================================
# COMMLOAN RAG SYSTEM - ENVIRONMENT VARIABLES
# =============================================================================

# =============================================================================
# GENERAL SETTINGS
# =============================================================================
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-in-production
API_VERSION=v1

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL
DATABASE_URL=postgresql://commloan_user:commloan_pass@postgres:5432/commloan_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis Cache
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# AWS CONFIGURATION
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# S3 Document Storage
S3_BUCKET_NAME=commloan-documents
S3_REGION=us-east-1

# =============================================================================
# LLM PROVIDER CONFIGURATIONS
# =============================================================================

# AWS Bedrock
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_ACCESS_KEY_ID=your-bedrock-access-key
BEDROCK_SECRET_ACCESS_KEY=your-bedrock-secret-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4000

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=4000

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-3-opus
OPENROUTER_TEMPERATURE=0.7

# Default LLM Provider
DEFAULT_LLM_PROVIDER=openai  # openai, anthropic, bedrock, openrouter
FALLBACK_LLM_PROVIDERS=anthropic,bedrock

# =============================================================================
# EMBEDDING CONFIGURATION
# =============================================================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Alternative: OpenAI Embeddings
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSION=1536

# =============================================================================
# RAG CONFIGURATION
# =============================================================================

# Re-ranking
RERANKING_ENABLED=true
RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKING_TOP_K=5
RERANKING_INITIAL_K=50

# Multi-Query
MULTI_QUERY_ENABLED=true
MULTI_QUERY_NUM_QUERIES=4

# Contextual Retrieval
CONTEXTUAL_RETRIEVAL_ENABLED=false
CONTEXTUAL_RETRIEVAL_DOC_TYPES=loan_policy,regulation

# Hierarchical RAG
HIERARCHICAL_RAG_ENABLED=true
HIERARCHICAL_MAX_PARENT_LEVELS=2

# Agentic RAG
AGENTIC_RAG_ENABLED=true

# Self-Reflective RAG
SELF_REFLECTIVE_RAG_ENABLED=false
CONFIDENCE_THRESHOLD=0.7

# =============================================================================
# DOCUMENT PROCESSING
# =============================================================================
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_CHUNK_SIZE=1000
USE_DOCLING=true
SUPPORTED_FILE_TYPES=pdf,docx,txt,md

# Document Processing Queue
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# API Security
API_RATE_LIMIT=100/minute
API_KEY_HEADER=X-API-Key

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_KNOWLEDGE_GRAPH=false
ENABLE_STREAMING_RESPONSES=true
ENABLE_COMPLIANCE_CHECKS=true
ENABLE_COST_OPTIMIZATION=true
ENABLE_PII_DETECTION=true

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
ENABLE_MONITORING=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Sentry (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# CloudWatch
CLOUDWATCH_ENABLED=false
CLOUDWATCH_LOG_GROUP=/commloan/rag-system

# =============================================================================
# SERVICE PORTS
# =============================================================================
API_GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
ADMIN_SERVICE_PORT=8002
RAG_SERVICE_PORT=8003
DOCUMENT_SERVICE_PORT=8004
UNDERWRITING_SERVICE_PORT=8005
COMPLIANCE_SERVICE_PORT=8006
ANALYTICS_SERVICE_PORT=8007

# Frontend Ports
ADMIN_DASHBOARD_PORT=3001
USER_PORTAL_PORT=3002

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================
# Plaid (Financial Data)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox  # sandbox, development, production

# Experian (Credit Reporting)
EXPERIAN_API_KEY=
EXPERIAN_API_URL=

# =============================================================================
# UNDERWRITING CONFIGURATION
# =============================================================================
# Risk Thresholds
MIN_CREDIT_SCORE=680
MIN_DSCR=1.25
MAX_LTV=0.80
MAX_DTI=0.43

# Loan Limits
MIN_LOAN_AMOUNT=50000
MAX_LOAN_AMOUNT=5000000

# =============================================================================
# COMPLIANCE CONFIGURATION
# =============================================================================
PII_DETECTION_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years for compliance
ENABLE_OFAC_SCREENING=false

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
WORKER_CONCURRENCY=4
MAX_CONNECTIONS=100
CONNECTION_TIMEOUT=30
REQUEST_TIMEOUT=60

# Cache TTL (seconds)
CACHE_TTL_EMBEDDINGS=86400  # 24 hours
CACHE_TTL_QUERIES=3600      # 1 hour
CACHE_TTL_CONFIG=300        # 5 minutes

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Hot Reload
RELOAD=true

# Debug Tools
ENABLE_PROFILER=false
ENABLE_SQL_ECHO=false

# Mock Services (for testing without real APIs)
MOCK_LLM_APIS=false
MOCK_AWS_SERVICES=false
